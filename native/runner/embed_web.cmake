# Generates web_assets.cpp from the browser UI in WEB_DIR (custos/public, unchanged). Invoked by
# add_custom_command (cmake -P). FILES is the '|'-separated list of paths relative to WEB_DIR; each
# is served at "/<path>", and "/" serves index.html as the former serveStatic did.
set(body "// Generated by embed_web.cmake from the custos/public browser UI. Do not edit.\n#include \"app/web_assets.hpp\"\n#include <array>\n\nnamespace odeum::runner {\nnamespace {\n")
string(REPLACE "|" ";" FILES "${FILES}")
set(table "")
set(index 0)
set(entries 0)
foreach(file IN LISTS FILES)
  get_filename_component(ext "${file}" LAST_EXT)
  string(TOLOWER "${ext}" ext)
  if(ext STREQUAL ".html")
    set(type "text/html; charset=utf-8")
  elseif(ext STREQUAL ".css")
    set(type "text/css; charset=utf-8")
  elseif(ext STREQUAL ".js" OR ext STREQUAL ".mjs")
    set(type "text/javascript; charset=utf-8")
  elseif(ext STREQUAL ".svg")
    set(type "image/svg+xml")
  elseif(ext STREQUAL ".png")
    set(type "image/png")
  elseif(ext STREQUAL ".ico")
    set(type "image/x-icon")
  else()
    message(FATAL_ERROR "embed_web.cmake: no content type for ${file}")
  endif()
  file(READ "${WEB_DIR}/${file}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "const unsigned char asset_${index}[] = {${bytes}0};\n")
  string(APPEND table "    {\"/${file}\", {\"${type}\", std::string_view(reinterpret_cast<const char*>(asset_${index}), ${size})}},\n")
  math(EXPR entries "${entries} + 1")
  if(file STREQUAL "index.html")
    string(APPEND table "    {\"/\", {\"${type}\", std::string_view(reinterpret_cast<const char*>(asset_${index}), ${size})}},\n")
    math(EXPR entries "${entries} + 1")
  endif()
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "struct Route { std::string_view path; WebAsset asset; };\nconst std::array<Route, ${entries}> routes{{\n${table}}};\n}\n")
string(APPEND body "const WebAsset* find_web_asset(std::string_view path) {\n    for (const auto& route : routes) if (route.path == path) return &route.asset;\n    return nullptr;\n}\n}\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
