# odeum.lorica_applied.compile_commands: every compile command in compile_commands.json carries
# Lorica's settings (cmake -P, no Python).
#
#   cmake -DCOMPILE_COMMANDS=<build>/compile_commands.json -DEXPECT=<build>/lorica_applied/expect.cmake -P <this>
#
# EXPECT is written by odeum_lorica_write_expectations() (cmake/OdeumLorica.cmake). Entries are
# split into Odeum's own sources (the project tree and generated files in the build tree outside
# _deps) and third-party sources (libdatachannel and its bundled libraries, compiled here with
# Lorica's baseline only, see odeum_harden_third_party). Both must have the baseline flags and no
# flag that undoes them; own C++ sources must also have Lorica's include directory and, where
# Odeum applies it, the force-included lorica/unsafe_api.hpp with deprecations as errors; own
# targets that asked for EXTENDED must have its flags. The last occurrence of a flag decides, as
# on the compiler's command line. C sources are checked for the flags C gets only.
# Prints "ODEUM_LORICA_SKIP:" (the test's SKIP_REGULAR_EXPRESSION) when nothing can be checked.
cmake_minimum_required(VERSION 3.24)

if(NOT EXPECT OR NOT EXISTS "${EXPECT}")
  message(FATAL_ERROR "lorica_compile_commands: EXPECT file missing (${EXPECT})")
endif()
include("${EXPECT}")

if(NOT HARDENED)
  message("ODEUM_LORICA_SKIP: Lorica target hardening is off (macOS with ODEUM_LORICA_MACOS_UNHARDENED=ON); compile commands not checked")
  return()
endif()
if(MULTI_CONFIG)
  message("ODEUM_LORICA_SKIP: multi-config generator; the expected FORTIFY level is per configuration, not checked")
  return()
endif()
if(NOT EXISTS "${COMPILE_COMMANDS}")
  message(FATAL_ERROR "lorica_compile_commands: ${COMPILE_COMMANDS} is missing (CMAKE_EXPORT_COMPILE_COMMANDS must be ON)")
endif()

file(READ "${COMPILE_COMMANDS}" database)
string(JSON entries LENGTH "${database}")
if(entries EQUAL 0)
  message(FATAL_ERROR "lorica_compile_commands: ${COMPILE_COMMANDS} has no entries")
endif()

# Value of the last -D/-U of <macro> in <arguments>: "<value>" ("1" for a bare -D), or "" when
# undefined or never defined.
function(_macro_state arguments macro out)
  set(state "")
  foreach(argument IN LISTS arguments)
    if(argument MATCHES "^[-/]D${macro}=(.*)$")
      set(state "${CMAKE_MATCH_1}")
    elseif(argument MATCHES "^[-/]D${macro}$")
      set(state 1)
    elseif(argument MATCHES "^[-/]U${macro}$")
      set(state "")
    endif()
  endforeach()
  set(${out} "${state}" PARENT_SCOPE)
endfunction()

# The last argument matching <family> (a regular expression), or "".
function(_last arguments family out)
  set(found "")
  foreach(argument IN LISTS arguments)
    if(argument MATCHES "${family}")
      set(found "${argument}")
    endif()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(_check_gnu arguments language own target out)
  set(problems "")
  _last("${arguments}" "^-f(no-)?stack-protector(-strong|-all|-explicit)?$" flag)
  if(NOT flag MATCHES "^-fstack-protector-(strong|all)$")
    list(APPEND problems "stack protector '${flag}'")
  endif()
  _last("${arguments}" "^-f(no-)?stack-clash-protection$" flag)
  if(NOT flag STREQUAL "-fstack-clash-protection")
    list(APPEND problems "stack clash protection '${flag}'")
  endif()
  if(PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    _last("${arguments}" "^-mbranch-protection=" flag)
    if(NOT flag STREQUAL "-mbranch-protection=standard")
      list(APPEND problems "branch protection '${flag}'")
    endif()
  else()
    _last("${arguments}" "^-f(no-)?cf-protection(=.*)?$" flag)
    if(NOT flag STREQUAL "-fcf-protection=full")
      list(APPEND problems "control-flow protection '${flag}'")
    endif()
  endif()
  _last("${arguments}" "^-f(no-)?(pic|PIC|pie|PIE)$" flag)
  if(NOT flag MATCHES "^-f(pic|PIC|pie|PIE)$")
    list(APPEND problems "position independent code '${flag}'")
  endif()
  _macro_state("${arguments}" _FORTIFY_SOURCE fortify)
  if(NOT "${FORTIFY_${language}}" STREQUAL "" AND NOT fortify STREQUAL "${FORTIFY_${language}}")
    list(APPEND problems "_FORTIFY_SOURCE '${fortify}' instead of ${FORTIFY_${language}}")
  endif()
  set(extended FALSE)
  if(own AND EXTENDED_OK AND target IN_LIST EXTENDED_TARGETS)
    set(extended TRUE)
    _last("${arguments}" "^-ftrivial-auto-var-init=" flag)
    if(NOT flag STREQUAL "-ftrivial-auto-var-init=zero")
      list(APPEND problems "EXTENDED -ftrivial-auto-var-init '${flag}'")
    endif()
  endif()
  if(language STREQUAL "CXX")
    _macro_state("${arguments}" _GLIBCXX_ASSERTIONS assertions)
    if(assertions STREQUAL "" OR assertions STREQUAL "0")
      list(APPEND problems "_GLIBCXX_ASSERTIONS not defined")
    endif()
    _macro_state("${arguments}" _LIBCPP_HARDENING_MODE mode)
    if(extended)
      set(wanted _LIBCPP_HARDENING_MODE_EXTENSIVE)
    else()
      set(wanted _LIBCPP_HARDENING_MODE_FAST)
    endif()
    if(NOT mode STREQUAL wanted)
      list(APPEND problems "_LIBCPP_HARDENING_MODE '${mode}' instead of ${wanted}")
    endif()
  endif()
  if(own AND language STREQUAL "CXX")
    set(include_dir FALSE)
    set(force_included FALSE)
    set(previous "")
    foreach(argument IN LISTS arguments)
      if(argument STREQUAL "-I${LORICA_INCLUDE_DIR}" OR argument STREQUAL "-isystem${LORICA_INCLUDE_DIR}"
          OR (argument STREQUAL "${LORICA_INCLUDE_DIR}" AND previous MATCHES "^-(I|isystem)$"))
        set(include_dir TRUE)
      endif()
      if((argument STREQUAL "${LORICA_HEADER}" AND previous STREQUAL "-include")
          OR argument STREQUAL "-include${LORICA_HEADER}")
        set(force_included TRUE)
      endif()
      set(previous "${argument}")
    endforeach()
    if(NOT include_dir)
      list(APPEND problems "Lorica include directory ${LORICA_INCLUDE_DIR} missing")
    endif()
    if(UNSAFE_API)
      if(NOT force_included)
        list(APPEND problems "-include ${LORICA_HEADER} missing")
      endif()
      _last("${arguments}" "^-W(no-)?(error=)?deprecated-declarations$" flag)
      if(NOT flag STREQUAL "-Werror=deprecated-declarations")
        list(APPEND problems "deprecations as errors '${flag}'")
      endif()
    endif()
  endif()
  set(${out} "${problems}" PARENT_SCOPE)
endfunction()

# MSVC with a Ninja or Makefile generator (written from LoricaHardening.cmake; not run in the
# cloud, where only GCC and Clang are available).
function(_check_msvc arguments language own target out)
  set(problems "")
  foreach(pair "/GS;^[-/]GS-?$" "/sdl;^[-/]sdl-?$" "/guard:cf;^[-/]guard:cf-?$")
    list(GET pair 0 wanted)
    list(GET pair 1 family)
    _last("${arguments}" "${family}" flag)
    string(REGEX REPLACE "^-" "/" flag "${flag}")
    # /GS is the compiler's default, so only its removal (/GS-) fails.
    if(flag MATCHES "-$" OR (NOT wanted STREQUAL "/GS" AND NOT flag STREQUAL wanted))
      list(APPEND problems "${wanted} '${flag}'")
    endif()
  endforeach()
  if(own AND language STREQUAL "CXX" AND EXTENDED_OK AND target IN_LIST EXTENDED_TARGETS)
    foreach(macro _MSVC_STL_HARDENING _MSVC_STL_DESTRUCTOR_TOMBSTONES)
      _macro_state("${arguments}" ${macro} value)
      if(NOT value STREQUAL "1")
        list(APPEND problems "EXTENDED ${macro} '${value}'")
      endif()
    endforeach()
  endif()
  set(${out} "${problems}" PARENT_SCOPE)
endfunction()

set(own_count 0)
set(third_party_count 0)
set(failed "")
math(EXPR last "${entries} - 1")
foreach(index RANGE ${last})
  string(JSON file GET "${database}" ${index} file)
  string(JSON output ERROR_VARIABLE no_output GET "${database}" ${index} output)
  string(JSON command ERROR_VARIABLE no_command GET "${database}" ${index} command)
  if(no_command)
    # The "arguments" form: a JSON array of strings.
    string(JSON count LENGTH "${database}" ${index} arguments)
    set(arguments "")
    math(EXPR count_last "${count} - 1")
    foreach(position RANGE ${count_last})
      string(JSON argument GET "${database}" ${index} arguments ${position})
      list(APPEND arguments "${argument}")
    endforeach()
  elseif(FRONTEND STREQUAL "MSVC")
    separate_arguments(arguments WINDOWS_COMMAND "${command}")
  else()
    separate_arguments(arguments UNIX_COMMAND "${command}")
  endif()
  if(file MATCHES "\\.c$")
    set(language C)
  else()
    set(language CXX)
  endif()
  string(FIND "${file}" "/_deps/" fetched)
  cmake_path(IS_PREFIX SOURCE_DIR "${file}" NORMALIZE in_source)
  cmake_path(IS_PREFIX BINARY_DIR "${file}" NORMALIZE in_build)
  set(own FALSE)
  if(fetched EQUAL -1 AND (in_source OR in_build))
    set(own TRUE)
    math(EXPR own_count "${own_count} + 1")
  else()
    math(EXPR third_party_count "${third_party_count} + 1")
  endif()
  # The target is the CMakeFiles/<target>.dir directory of the object file.
  set(target "")
  if(output MATCHES "CMakeFiles/([^/]+)\\.dir/")
    set(target "${CMAKE_MATCH_1}")
  endif()
  if(FRONTEND STREQUAL "MSVC")
    _check_msvc("${arguments}" ${language} ${own} "${target}" problems)
  else()
    _check_gnu("${arguments}" ${language} ${own} "${target}" problems)
  endif()
  if(problems)
    if(own)
      set(kind own)
    else()
      set(kind third-party)
    endif()
    string(REPLACE ";" ", " problems "${problems}")
    list(APPEND failed "${kind} ${file} (${target}): ${problems}")
  endif()
endforeach()

if(own_count EQUAL 0)
  message(FATAL_ERROR "lorica_compile_commands: no entry for Odeum's own sources under ${SOURCE_DIR}")
endif()
list(LENGTH EXTENDED_TARGETS extended_count)
if(failed)
  list(LENGTH failed failed_count)
  string(REPLACE ";" "\n  " failed "${failed}")
  message(FATAL_ERROR "Lorica is missing or undone in ${failed_count} compile commands:\n  ${failed}")
endif()
message(STATUS "Lorica settings present in all ${entries} compile commands: ${own_count} own, "
  "${third_party_count} third-party (EXTENDED: ${EXTENDED_OK} for ${extended_count} targets, "
  "unsafe API rejection: ${UNSAFE_API}, FORTIFY C/C++: '${FORTIFY_C}'/'${FORTIFY_CXX}')")
