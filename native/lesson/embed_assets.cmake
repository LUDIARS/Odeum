# Generates assets.cpp from files on disk. Invoked by add_custom_command (cmake -P) with
#   -DLIST=<file with one "<route>|<absolute file>|<media type>" per line>  -DOUTPUT=<assets.cpp>
# The service never reads these files at runtime: pages and built-in courses ship inside the binary.
set(body "// Generated by embed_assets.cmake. Do not edit.\n#include \"assets.hpp\"\n#include <array>\n\nnamespace odeum::lesson {\nnamespace {\n")
set(table "")
set(index 0)
file(STRINGS "${LIST}" ENTRIES)
foreach(entry IN LISTS ENTRIES)
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 route)
  list(GET parts 1 file)
  list(GET parts 2 type)
  file(READ "${file}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "const unsigned char asset_${index}[] = {${bytes}0};\n")
  string(APPEND table "    {\"${route}\", {\"${type}\", std::string_view(reinterpret_cast<const char*>(asset_${index}), ${size})}},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "struct Route { std::string_view path; Asset asset; };\nconst std::array<Route, ${index}> routes{{\n${table}}};\n}\n")
string(APPEND body "const Asset* find_asset(std::string_view path) {\n    for (const auto& route : routes) if (route.path == path) return &route.asset;\n    return nullptr;\n}\n")
string(APPEND body "std::vector<std::string_view> asset_paths(std::string_view prefix) {\n    std::vector<std::string_view> out;\n    for (const auto& route : routes) if (route.path.starts_with(prefix)) out.push_back(route.path);\n    return out;\n}\n}\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
